PORT=8080
PUBLIC_BASE_URL=https://cti.example.com
TOKEN_STORE_PATH=/data/ringcentral-tokens.json
CORS_ORIGINS=https://*.gohighlevel.com,https://*.leadconnectorhq.com
GHL_OAUTH_CLIENT_ID=replace-with-highlevel-marketplace-client-id
GHL_OAUTH_CLIENT_SECRET=replace-with-highlevel-marketplace-client-secret
GHL_OAUTH_USER_TYPE=Location
GHL_APP_ID=replace-with-highlevel-marketplace-app-id
GHL_APP_SHARED_SECRET=replace-with-highlevel-shared-secret
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=replace-with-ringcentral-client-id
RINGCENTRAL_CLIENT_SECRET=replace-with-ringcentral-client-secret
RINGCENTRAL_EXTENSION_ID=~
APP_CONFIG_PATH=./app-config.example.json
